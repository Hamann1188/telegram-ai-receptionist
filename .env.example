# Copy to .env and fill in. Never commit .env.

# Anthropic API key from https://platform.claude.com
RECEPTIONIST_ANTHROPIC_API_KEY=
# Set explicitly so a globally exported ANTHROPIC_BASE_URL (e.g. a local proxy) is never picked up
RECEPTIONIST_ANTHROPIC_BASE_URL=https://api.anthropic.com
RECEPTIONIST_MODEL=claude-opus-5-5

# Bot token from @BotFather
RECEPTIONIST_BOT_TOKEN=
# Admin group chat id (starts with -100); add the bot to the group first
RECEPTIONIST_ADMIN_CHAT_ID=
RECEPTIONIST_EMERGENCY_NUMBER=103

# PostgreSQL (docker compose service "db"); host port 5433 so it can run next to project 1
POSTGRES_USER=receptionist
POSTGRES_PASSWORD=receptionist
POSTGRES_DB=receptionist
RECEPTIONIST_DATABASE_URL=postgresql+asyncpg://receptionist:receptionist@localhost:5433/receptionist
